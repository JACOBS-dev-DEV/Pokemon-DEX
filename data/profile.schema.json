{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JacobS Personal Pokemon Profile",
  "type": "object",
  "required": ["profile_id", "pokemon"],
  "properties": {
    "profile_id": {"type": "string"},
    "display_name": {"type": "string"},
    "pokemon": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["species_name"],
        "properties": {
          "national_dex": {"type": ["integer", "null"]},
          "regional_dex": {"type": ["integer", "null"]},
          "species_name": {"type": "string"},
          "form": {"type": ["string", "null"]},
          "type_1": {"type": ["string", "null"]},
          "type_2": {"type": ["string", "null"]},
          "tera_type": {"type": ["string", "null"]},
          "caught": {"type": "boolean"},
          "obtained": {"type": "boolean"},
          "in_team": {"type": "boolean"},
          "team_slot": {"type": ["integer", "null"], "minimum": 1, "maximum": 6},
          "battle_count": {"type": ["integer", "null"], "minimum": 0},
          "owned_count": {"type": ["integer", "null"], "minimum": 0},
          "ability": {"type": ["string", "null"]},
          "stats": {
            "type": ["object", "null"],
            "properties": {
              "hp": {"type": ["integer", "null"]},
              "attack": {"type": ["integer", "null"]},
              "defense": {"type": ["integer", "null"]},
              "special_attack": {"type": ["integer", "null"]},
              "special_defense": {"type": ["integer", "null"]},
              "speed": {"type": ["integer", "null"]},
              "total": {"type": ["integer", "null"]}
            }
          },
          "ribbons": {"type": "array", "items": {"type": "string"}},
          "games": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": ["string", "null"]}
        }
      }
    }
  }
}
